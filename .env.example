# Required. Encrypts provider API keys stored in the database.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Optional. Days to keep uploaded files and rendered slides.
# NOTE: not implemented yet - nothing reads this and nothing is cleaned up.
JOB_RETENTION_DAYS=7

# There is deliberately no APP_PASSWORD. It used to be listed here as though it
# gated the UI; no code ever read it, so setting it protected nothing. The app
# has no authentication - keep it bound to loopback (see docker-compose.yml).
