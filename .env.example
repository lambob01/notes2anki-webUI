# Required. Encrypts provider API keys stored in the database.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Optional. Set a value to require a password to reach the UI.
# Leave empty for no login (the default for a trusted home LAN).
APP_PASSWORD=

# Optional. Days to keep uploaded files and rendered slides.
JOB_RETENTION_DAYS=7
